{
  "name": "@parimaan/infra",
  "version": "0.0.0",
  "private": true,
  "description": "Parimaan AWS infrastructure (CDK v2, TypeScript)",
  "bin": {
    "infra": "bin/parimaan.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . -c ../eslint.config.mjs --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "cdk": "cdk",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.208.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "aws-cdk": "^2.1024.0",
    "tsx": "^4.20.0"
  }
}
