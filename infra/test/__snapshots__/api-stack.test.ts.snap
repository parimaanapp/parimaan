    "ApiSchema510EECD7": {
      "Properties": {
        "ApiId": {
          "Fn::GetAtt": [
            "ApiF70053CD",
            "ApiId",
          ],
        },
        "Definition": "# Parimaan GraphQL schema — SINGLE SOURCE OF TRUTH.
#
# This file feeds four consumers:
#   1. ferry_generator      → Dart types for mobile/
#   2. graphql-codegen      → TypeScript types for api/ and web/
#   3. urql                 → web/ client operations
#   4. Zod schema authoring → server-side validation in api/
#
# Never hand-edit a generated artifact. Edit this file, regenerate, commit both.
# Any change here is a \`doc-updater\` trigger: re-sync SYSTEM_DESIGN.md §6.1.
#
# The real schema (SYSTEM_DESIGN.md §6.1 — households, recipes, pantry, etc.)
# lands incrementally starting W1, alongside the resolvers that implement each
# field. \`_health\` was the W1 placeholder (AppSync → Lambda → response
# pipeline). \`me\` / \`createHousehold\` / \`User.households\` are the first real
# slice (SYSTEM_DESIGN.md §5.1, §5.2), landing W3/W4 per E2E_MVP_PLAN.md §4.

scalar AWSDateTime
scalar AWSJSON
scalar AWSDate

type Query {
  """Health-check field. Proves the AppSync → Lambda → response pipeline works."""
  _health: String!

  """
  Returns the authenticated caller, upserting their \`users\` row on first
  login (SYSTEM_DESIGN.md §5.1). Does not include \`households\` — see the
  separate \`User.households\` field resolver, which exists specifically to
  break the User↔HouseholdMembership↔User type cycle at arbitrary query
  depth (a single flat resolver on \`me\` cannot terminate that cycle).
  """
  me: User!

  """
  Returns a single household, fully hydrated with its settings and every
  member. Exists because \`me { households { household { members } } }\`
  deliberately returns each membership's household with an empty \`members\`
  list (a recursion cutoff, not a bug) — the Members list screen and any
  poll-based refresh need this instead. Any member may read; a non-member
  or a nonexistent householdId both deny identically (never an existence
  oracle).
  """
  household(householdId: ID!): Household!

  """
  Returns a household's pantry items, optionally filtered by a case-
  insensitive substring \`search\` against \`name\`, and/or an exact \`category\`
  match. Requires the caller to already be a member of \`householdId\` — a
  non-member or a nonexistent householdId both deny identically, matching
  \`Query.household\`'s existence-oracle-avoidance. \`unit\`/\`category\` are
  free text server-side-canonicalised against a known set (E2E_MVP_PLAN.md
  §11.2.4) rather than closed enums, so an unrecognised value from an older
  client is never rejected outright.
  """
  pantry(householdId: ID!, search: String, category: String): [PantryItem!]!

  """
  Returns a household's recipes, optionally filtered by \`role\`,
  \`isFavorite\`, and/or \`inRotation\` (the last added W10, §16.2.5 — lets
  the recipe picker offer a "rotation only" view without over-fetching
  and filtering client-side). Requires the caller to already be a member
  of \`householdId\` — a non-member or a nonexistent \`householdId\` both
  deny identically, matching \`Query.pantry\`/\`Query.household\`. Ordered
  favorite-first, then rotation-first, then by title (PRD §7.1:
  "favorites and rotation surfaced first" — both halves of that sentence
  are implemented as of W10; only the favorite half was until then).
  Unlike \`PantryItem\`'s free-text \`unit\`/\`category\`, \`role\`/\`cuisineTier1\`/
  \`dietaryTags\` are closed enums — an unrecognised value is rejected at
  write time and never persisted (E2E_MVP_PLAN.md §12.2.6). This query
  deliberately does not hydrate \`Recipe.ingredients\` inline — see that
  field's own doc.
  """
  recipes(householdId: ID!, role: RecipeRole, isFavorite: Boolean, inRotation: Boolean): [Recipe!]!

  """
  Returns a single recipe by \`id\` — added in W6 S7 so the Detail screen can
  read one recipe (selecting \`ingredients\`) without re-fetching the whole
  household's \`Query.recipes\` list just to display one row. Takes no
  \`householdId\`: the recipe's household is looked up from \`id\` itself, and
  RLS is what actually enforces "your own household's recipes only" here —
  same \`id\`-only pattern as \`Mutation.updateRecipe\`/\`deleteRecipe\`. A
  nonexistent \`id\` and a real \`id\` in another household both deny
  identically with \`NOT_FOUND\`.
  """
  recipe(id: ID!): Recipe!

  """
  Returns the caller's own notification preferences for \`householdId\`.
  Requires the caller to already be a member of \`householdId\`. A caller with
  no row yet (never having saved a preference) gets the SD-specified \`TRUE\`
  defaults computed in place — this query never implicitly writes a row
  (E2E_MVP_PLAN.md §14.2.8's S8 RED-test list: "decide and assert, don't
  leave it emergent" — decided as a pure read, no write-on-read side effect).
  \`fcm_token\` is deliberately absent from \`NotificationPreferences\` entirely
  (§14.2.6) — it is a device push credential, W20 registers it via its own
  mutation, and no client ever reads it back.
  """
  notificationPreferences(householdId: ID!): NotificationPreferences!

  """
  Returns \`householdId\`'s menu for the week starting \`weekStartDate\`, or
  \`null\` if no menu has been created for that week yet — never an
  implicit \`createMenu\` (W9 S2, E2E_MVP_PLAN.md §15.3). Also the read path
  for "today's agenda" (§15.2.5): there is no separate server endpoint for
  it — a client fetches the current week's menu through this same field
  and filters \`items\` by \`dayOfWeek\` itself. Requires the caller to
  already be a member of \`householdId\`.
  """
  menu(householdId: ID!, weekStartDate: AWSDateTime!): Menu

  """
  Proposes recipes for every currently-empty slot on \`menuId\`'s menu
  (recency avoidance + cuisine bias, W10 §16.2.8) WITHOUT writing anything
  — a pure read, a deliberate deviation from SD §6.1's original single-
  mutation \`autoFillWeek(menuId, overwrite): Menu!\` (§16.2.1, D3). Safe to
  call repeatedly for a free "regenerate": each call is an independently-
  random proposal (D11), never the same twice. The client accepts the
  proposal verbatim, or edits it, then calls \`Mutation.autoFillWeek\` with
  the resulting item list to actually commit. \`filledCount\`/\`unfilledSlots\`
  distinguish a full proposal from a partial one (D5) — a household with
  too few in-rotation recipes for some role gets a partial, honest
  proposal, never an error (D6). Requires the caller to already be a
  member of the menu's household, denied identically to a nonexistent
  \`menuId\` (no existence oracle, matching \`addMenuItem\`'s own pattern).
  """
  autoFillPreview(menuId: ID!): AutoFillPreviewResult!
}

type Mutation {
  """
  Creates a household with the caller as its \`primary\` member, default
  settings, and a generated invite code (SYSTEM_DESIGN.md §5.2).
  """
  createHousehold(name: String!): Household!

  """
  Joins the caller to a household by invite code, as a \`member\`. Idempotent:
  re-joining a household the caller already belongs to succeeds without a
  second membership row. Capped at 5 members per household
  (HOUSEHOLD_FULL). Rate-limited per caller against guessed invite codes
  (RATE_LIMITED). Deliberately has no membership-required authorization
  check — the caller is by definition not yet a member.
  """
  joinHousehold(inviteCode: String!): Household!

  """
  Applies a partial patch to a household's settings — every \`input\` field is
  optional, and an absent field leaves that column unchanged (an explicit
  \`null\` is rejected). Requires the caller to already be a member of
  \`householdId\`. Returns the full \`Household!\`, not just its settings (W8
  S10, E2E_MVP_PLAN.md §14.2.10 D4) — the settings remain reachable via
  \`Household.settings\`, and the widened shape is what lets this mutation
  attach to \`Subscription.onHouseholdChanged\`.
  """
  updateHouseholdSettings(householdId: ID!, input: HouseholdSettingsInput!): Household!

  """
  Replaces a household's invite code with a freshly-generated one and returns
  the updated household. Any member may rotate — there is deliberately no
  role check. NOT idempotent: each successful call invalidates the previous
  code for everyone holding it. Rate-limited per caller (RATE_LIMITED), more
  tightly than \`joinHousehold\`, because rotating is destructive for
  co-members. Requires the caller to already be a member of \`householdId\`.
  """
  rotateInviteCode(householdId: ID!): Household!

  """
  Removes the caller's own membership from a household. Idempotent and
  deliberately gated differently from every other household-scoped mutation:
  a caller who is not (or is no longer) a member returns \`true\` rather than a
  denial, since "not a member" is exactly the state this mutation asks for.
  The primary member cannot leave (FORBIDDEN) — in MVP the only exit for a
  primary is \`deleteHousehold\`, as primary-role transfer is post-MVP.
  """
  leaveHousehold(householdId: ID!): Boolean!

  """
  Permanently deletes a household along with its memberships and settings.
  Primary-only (FORBIDDEN for any other member, and for a non-member — which
  is also what a nonexistent \`householdId\` returns, so this is never a
  household-existence oracle). \`confirmationName\` must match the household's
  current \`name\` exactly — case-sensitive, no trimming — or the mutation
  fails (VALIDATION) without deleting anything. Irreversible.
  """
  deleteHousehold(householdId: ID!, confirmationName: String!): Boolean!

  """
  Adds a pantry item to a household. Requires the caller to already be a
  member of \`householdId\`. \`addedBy\` is never a client-supplied argument —
  it is always the verified caller, taken from their authenticated identity.
  """
  addPantryItem(householdId: ID!, input: PantryItemInput!): PantryItem!

  """
  Applies a partial patch to a pantry item — every \`input\` field is
  optional, and an absent field leaves that column unchanged (an explicit
  \`null\` is rejected), the same semantics as \`updateHouseholdSettings\`.
  Takes no \`householdId\`: the item's household is looked up from \`id\`
  itself, and RLS is what actually enforces "your own household's items
  only" here — a caller who isn't a member of the item's household gets
  the identical NOT_FOUND response as a nonexistent \`id\`, never a separate
  "forbidden" signal that would leak which case it was.
  """
  updatePantryItem(id: ID!, input: PantryItemPatchInput!): PantryItem!

  """
  Deletes a pantry item and returns the row that was deleted, so other
  devices' \`onPantryChanged\` subscription (a later slice) can learn which
  item vanished. Same \`id\`-only membership resolution as \`updatePantryItem\`.
  A second call for the same \`id\` denies identically to the first call ever
  having been for a nonexistent item — deletion is not itself observable
  through the error shape.
  """
  deletePantryItem(id: ID!): PantryItem!

  """
  Adds up to 50 pantry items in one call, in a single transaction — either
  all items are added or none are (a failure partway through rolls back the
  whole batch, not just the failed item). Requires the caller to already be
  a member of \`householdId\`. The 50-item cap exists purely to bound the
  request; there is no cap on how many pantry items a household can have in
  total. Has no W5 caller (photo-pantry, W18, is its first real one) and is
  deliberately not on \`onPantryChanged\`'s mutation list — a list-shaped
  payload can't fan out to that subscription's single-\`PantryItem\` shape.
  """
  bulkAddPantryItems(householdId: ID!, items: [PantryItemInput!]!): [PantryItem!]!

  """
  Creates a recipe: the parent row plus its ingredients, in one transaction
  — a failure partway through rolls back the whole recipe, not just the
  failed ingredient (same shape as \`bulkAddPantryItems\`). Requires the
  caller to already be a member of \`householdId\`. \`role\` is required with
  no default: this is the "role assignment required" DoD gate's actual
  enforcement point (E2E_MVP_PLAN.md §12.7 D1/D2).

  \`source\` is the confirm-a-draft path (W7 S6, E2E_MVP_PLAN.md §13.2.4
  D2): absent (every pre-W7 caller, unchanged) → \`sourceType: user\`,
  \`sourceUrl: null\`. When present, \`sourceType\` is restricted server-side
  to \`url\`/\`freeform_ai\` only — \`curated\` (the W13/W14 seeder) and \`ai\`
  (a future cook-from-pantry feature) are server-owned values a client can
  never claim, rejected with \`VALIDATION\` if attempted. \`sourceUrl\` is
  required when \`sourceType: url\` and rejected for every other
  \`sourceType\` (including absent \`source\`).
  """
  createRecipe(householdId: ID!, input: RecipeInput!, source: RecipeSourceAttribution): Recipe!

  """
  Applies a partial patch to a recipe — every \`input\` field is optional,
  and an absent field leaves that column unchanged (an explicit \`null\` is
  rejected), the same convention as \`updateHouseholdSettings\`/
  \`updatePantryItem\`. \`ingredients\`/\`steps\` are a third semantic: when
  PRESENT (even as \`[]\`) they REPLACE the whole list rather than patching
  individual entries; absent leaves the existing list untouched
  (E2E_MVP_PLAN.md §12.2.4). Takes no \`householdId\`: the recipe's household
  is looked up from \`id\` itself, and RLS is what actually enforces "your
  own household's recipes only" here — a caller who isn't a member of the
  recipe's household gets the identical NOT_FOUND response as a
  nonexistent \`id\`.
  """
  updateRecipe(id: ID!, input: RecipePatchInput!): Recipe!

  """
  Deletes a recipe and returns the row that was deleted, so a future
  \`onRecipeChanged\` subscriber can learn which recipe vanished (matching
  \`deletePantryItem\`'s §11.2.1 precedent). Same \`id\`-only membership
  resolution as \`updateRecipe\`. A second call for the same \`id\` denies
  identically to the first call ever having been for a nonexistent recipe.
  \`recipe_ingredients\` for the deleted recipe are removed via cascade.
  """
  deleteRecipe(id: ID!): Recipe!

  """
  Sets whether a recipe is favorited — the caller supplies the desired end
  state (\`favorite: true\`/\`false\`), not a toggle, so repeat calls with the
  same value are idempotent. Household-level, not per-user (PRD §7.1):
  every member sees the same favorite flag. Same \`id\`-only, RLS-gated
  membership resolution as \`updateRecipe\`/\`deleteRecipe\`.
  """
  favoriteRecipe(id: ID!, favorite: Boolean!): Recipe!

  """
  Sets whether a recipe is in rotation — same end-state-not-toggle,
  household-level, \`id\`-only pattern as \`favoriteRecipe\`. \`inRotation\` is
  what a future weekly-plan auto-fill (W10) filters candidate recipes by;
  this mutation only flips the flag, it does not itself consume it.
  """
  setInRotation(id: ID!, inRotation: Boolean!): Recipe!

  """
  Parses free-text recipe content (pasted from WhatsApp, a blog, a
  handwritten transcription) into an unsaved \`RecipeDraft\` via Gemini
  (E2E_MVP_PLAN.md §13.3 S3, D11). Deliberately takes no \`householdId\` —
  this resolver runs on a non-VPC Lambda with no route to Aurora (§13.2.1
  D3), so it cannot enforce \`requireHouseholdMember\`; accepting an
  argument it cannot authorize would violate this codebase's existence-
  oracle convention. The caller is still a verified Cognito principal, and
  the real abuse control is the per-user daily rate limit below, not
  household membership. Rate-limited at 20/day per user (\`'freeformParse'\`,
  §13.2.9 D8) — input over 4,000 characters is rejected before any
  provider call is made (a cost control, not just validation). Nothing is
  written to the database: the client calls \`Mutation.createRecipe\` with
  \`source: {sourceType: freeform_ai}\` to persist the confirmed draft
  (§13.2.4 D2).
  """
  parseFreeformRecipe(text: String!): RecipeDraft!

  """
  Fetches a recipe page by URL and parses its JSON-LD \`Recipe\` schema into
  an unsaved \`RecipeDraft\` (E2E_MVP_PLAN.md §13.3 S5). Same \`householdId\`
  drop and non-VPC rationale as \`parseFreeformRecipe\` above (§13.2.1 D3).
  The fetcher enforces the full SSRF control set (§13.2.10): \`https\` only,
  no credentials/non-default-port/IP-literal host, every DNS-resolved
  address checked against private/reserved ranges, at most 3 redirects
  with the full check re-run on every hop, an 8s/1MB budget, and an
  HTML-only content-type check. Rate-limited at 30/day per user
  (\`'urlImport'\`, §13.2.9 D8), checked before any DNS lookup. A fetch
  failure and a "no usable recipe found on the page" parse failure are
  both surfaced identically (\`URL_UNREADABLE\`) — never distinguished,
  since revealing *why* a URL failed (e.g. "that resolves to a private
  address") would itself be an internal-network oracle. Nothing is
  written to the database: \`sourceUrl\` on the returned draft is set to the
  confirmed URL, and the client calls \`Mutation.createRecipe\` with
  \`source: {sourceType: url, sourceUrl}\` to persist the confirmed draft.
  """
  importRecipeFromUrl(url: String!): RecipeDraft!

  """
  Applies a partial patch to the caller's own notification preferences for
  \`householdId\` — every \`input\` field is optional, and an absent field
  leaves that column unchanged (an explicit \`null\` is rejected, the
  \`updateHouseholdSettings\`/\`updatePantryItem\` convention). Requires the
  caller to already be a member of \`householdId\`. The first successful call
  for a \`(caller, householdId)\` pair materialises the row (defaulting every
  field not present in this patch to \`TRUE\`); every call after that is a
  genuine partial update. Always scoped to the CALLER's own row — there is
  no way to patch another member's preferences through this mutation.
  """
  updateNotificationPreferences(householdId: ID!, input: NotificationPreferencesPatchInput!): NotificationPreferences!

  """
  Creates \`householdId\`'s menu for the week starting \`weekStartDate\`, or
  returns the existing one if that week already has a menu (W9 S2,
  E2E_MVP_PLAN.md §15.3) — idempotent, never a second row and never a
  \`ConflictError\` for a repeat call. Requires the caller to already be a
  member of \`householdId\`.
  """
  createMenu(householdId: ID!, weekStartDate: AWSDateTime!): Menu!

  """
  Places a recipe into one \`(dayOfWeek, mealSlot, slotRole)\` slot on
  \`menuId\`'s menu (W9 S3, E2E_MVP_PLAN.md §15.3). Requires the caller to be
  a member of the menu's household. Rejected server-side (never just a
  client-side check) when: \`mealSlot\` isn't in the household's
  \`mealsEnabled\`; the slot is already at its configured cap (1 for
  \`breakfast\`/\`snacks\`, \`mealStructure[mealSlot][slotRole]\` for
  \`lunch\`/\`dinner\`); or \`recipeId\` doesn't belong to this same household.
  """
  addMenuItem(menuId: ID!, input: MenuItemInput!): MenuItem!

  """
  Removes one \`MenuItem\` by id, freeing its slot (W9 S3, E2E_MVP_PLAN.md
  §15.3). Idempotent: a nonexistent or already-removed \`id\` returns \`false\`,
  never an error — matching \`leaveHousehold\`'s precedent, not
  \`deletePantryItem\`'s. Requires the caller to be a member of the item's
  menu's household; a real \`id\` belonging to another household is denied
  identically to a nonexistent one (both return \`false\`).
  """
  removeMenuItem(id: ID!): Boolean!

  """
  Commits \`items\` (typically an accepted or edited \`Query.autoFillPreview\`
  proposal) to \`menuId\`'s menu — the write half of W10's dry-run design
  (§16.2.1, D3). \`overwrite: true\` deletes every existing item WITHOUT
  \`madeAt\` set first (manual or auto-filled alike, D4) — an item the
  household already cooked (\`madeAt\` set) is NEVER deleted regardless of
  \`overwrite\`. Each submitted item is re-validated against LIVE state
  (household ownership, \`mealsEnabled\`, in-rotation, cap) rather than
  trusted from the proposal — one that no longer fits is silently skipped,
  not an error (best-effort partial commit, D6); the response's own
  \`filledCount\`/\`unfilledSlots\` report exactly what happened, which can
  legitimately differ from what the preview promised. Requires the caller
  to already be a member of the menu's household, denied identically to a
  nonexistent \`menuId\`.
  """
  autoFillWeek(menuId: ID!, overwrite: Boolean!, items: [MenuItemInput!]!): AutoFillResult!

  """
  Generates \`menuId\`'s shopping list — aggregates every non-staple
  ingredient across the menu's \`menu_items\` (D2's fuzzy/similarity
  matching, cross-recipe), subtracts current pantry stock (D3's unit-
  conversion-aware reduction), and writes the result as a fresh
  \`ShoppingList\` (W11 S2, E2E_MVP_PLAN.md §17.3). An empty menu, or one
  whose every ingredient is staple-excluded, produces a list with zero
  items — never an error. Requires the caller to already be a member of
  the menu's household, denied identically to a nonexistent \`menuId\`
  (matching \`addMenuItem\`/\`autoFillWeek\`'s own pattern). Refuses a second
  call while an OPEN list already exists for this \`menuId\` (\`CONFLICT\`) —
  \`regenerateShoppingList\` is the only mutation that may write to an
  existing list.
  """
  generateShoppingList(menuId: ID!): ShoppingList!

  """
  Regenerates \`menuId\`'s shopping list via D8's merge-regenerate design
  (E2E_MVP_PLAN.md §17.2.8): every already-had (\`purchased\`/\`movedToPantry\`)
  or manually-added (\`sourceRecipeId: null\`, reserved for a future
  \`addShoppingListItem\`) item is preserved untouched; only the remaining
  auto-generated, not-yet-had portion is recomputed against CURRENT menu/
  pantry state. \`confirmed: false\` (or when no open list exists yet, in
  which case this behaves identically to a first \`generateShoppingList\`
  call) previews exactly what WOULD change — an unpersisted \`ShoppingList\`
  a client can render real "N kept, M recomputed" confirm-dialog copy from
  — without writing anything; \`confirmed: true\` commits the merge. Server-
  enforced, never a client-only confirm dialog. Requires the caller to
  already be a member of the menu's household, denied identically to a
  nonexistent \`menuId\`.
  """
  regenerateShoppingList(menuId: ID!, confirmed: Boolean!): ShoppingList!

  """
  Marks \`itemId\` as bought and moves it into the household's pantry in one
  transaction (SD §5.7, W11 S3, E2E_MVP_PLAN.md §17.3). The confirmed
  \`quantity\` (D5: defaults to the shopping-list quantity client-side,
  editable) is upserted into \`pantry_items\` — matched against an existing
  row by D2's fuzzy name match AND D3's unit-conversion-aware
  compatibility (a same-family cross-unit pair converts and increments;
  a cross-family or unrecognised-unit match creates a fresh row instead of
  incorrectly summing) — and \`itemId\` is flipped
  \`purchased\`/\`movedToPantry\` (with \`purchasedBy\`/\`purchasedAt\` stamped)
  atomically with that pantry write: a failure on either half rolls back
  both. Returns the item's full parent \`ShoppingList!\` (D1's widened
  return type, §17.2.1), not just the one item, so this mutation can
  attach to a future \`onShoppingListChanged\` subscription without a
  second return-type change. Takes no \`householdId\`: the item's household
  is looked up via its parent list, the same \`id\`-only, RLS-scoped
  membership resolution \`updatePantryItem\` uses — a non-member is denied
  identically to a nonexistent \`itemId\`. A second call on an
  already-\`purchased\` item is rejected with \`CONFLICT\` rather than
  silently double-counting the pantry increment. \`quantity\` must be
  strictly positive — zero, negative, or absent/\`null\` is rejected at
  validation, before any write.
  """
  haveIt(itemId: ID!, quantity: Float!): ShoppingList!

  """
  Marks \`itemId\` bought and moves it into the household's pantry in one
  transaction (D5/D6, E2E_MVP_PLAN.md §18.2.5/§18.2.6, W12 S3) — the
  "check off" counterpart to \`haveIt\`. Deliberately takes NO \`quantity\`
  argument (D5, locked): the pantry write always uses the shopping-list
  item's own already-known \`quantity\`/\`unit\`, since a purchase is closing
  out something the list already specified, not a fresh manual entry.
  Matched against an existing pantry row by the identical D2/D3 fuzzy-name
  and unit-conversion-aware compatibility \`haveIt\` already uses (a
  same-family cross-unit pair converts and increments, preserving that
  row's own existing \`expiryDate\` untouched; a cross-family or
  unrecognised-unit match creates a fresh row instead of incorrectly
  summing). A fresh row (no match) is inserted with its \`expiryDate\` set
  from the item's \`category\` via the locked default-expiry table (O3,
  §18.3 S1) rather than \`haveIt\`'s own \`null\` — PRD's "bought items ...
  with expiry defaults" requirement, absent from "Have it." \`itemId\` is
  flipped \`purchased\`/\`movedToPantry\` (with \`purchasedBy\`/\`purchasedAt\`
  stamped) atomically with that pantry write: a failure on either half
  rolls back both. Returns the item's full parent \`ShoppingList!\` (D1's
  widened return type, §18.2.1) so this mutation can attach to
  \`onShoppingListChanged\` below. Takes no \`householdId\`: the item's
  household is looked up via its parent list, the same \`id\`-only,
  RLS-scoped membership resolution \`haveIt\` uses — a non-member is denied
  identically to a nonexistent \`itemId\`. A second call on an
  already-\`purchased\` item is rejected with \`CONFLICT\` rather than
  silently double-counting the pantry increment.
  """
  markPurchased(itemId: ID!): ShoppingList!
}

type Subscription {
  """
  Pushes the added/updated/deleted \`PantryItem\` to every other connected
  device in \`householdId\` (E2E_MVP_PLAN.md §11.2.1). Subscribe-time
  authorization is a Lambda resolver on this field (not an API-level
  authorizer — SD §10.4 deviation, E2E_MVP_PLAN.md §11.2.9): a non-member
  or nonexistent \`householdId\` is denied identically, matching every other
  household-scoped resolver's existence-oracle avoidance. Not wired to
  \`bulkAddPantryItems\` — a list-shaped payload can't fan out to this
  single-\`PantryItem\` shape (§11.2.1).
  """
  onPantryChanged(householdId: ID!): PantryItem
    @aws_subscribe(mutations: ["addPantryItem", "updatePantryItem", "deletePantryItem"])

  """
  Pushes the added/updated/deleted/favorited/rotation-flagged \`Recipe\` to
  every other connected device in \`householdId\` (E2E_MVP_PLAN.md §12.3
  S11, D6 — pulled forward from a planner-recommended W8). Same
  subscribe-time Lambda-resolver authorization pattern as \`onPantryChanged\`
  (SD §10.4 deviation, §11.2.9): a non-member or nonexistent \`householdId\`
  is denied identically.
  """
  onRecipeChanged(householdId: ID!): Recipe
    @aws_subscribe(
      mutations: ["createRecipe", "updateRecipe", "deleteRecipe", "favoriteRecipe", "setInRotation"]
    )

  """
  Pushes the household to every other connected device in \`householdId\` on a
  join, an invite-code rotation, or a settings change (W8 S10,
  E2E_MVP_PLAN.md §14.2.10 D4/D5 — closes Phase 1's DoD line, previously
  shipped only as \`HouseholdSyncPolicy\`'s poll). Same subscribe-time
  Lambda-resolver authorization pattern as \`onPantryChanged\`/
  \`onRecipeChanged\` (SD §10.4 deviation, §11.2.9): a non-member or
  nonexistent \`householdId\` is denied identically. \`leaveHousehold\`/
  \`deleteHousehold\` are deliberately NOT on this mutation list — both return
  \`Boolean!\`, a structural type mismatch against a \`Household\`-shaped
  subscription regardless of authorization (AppSync requires an
  \`@aws_subscribe\`d mutation's return type to match the subscription
  field's), and even setting that aside, either would need to hydrate a
  \`Household\` (members + settings, via \`buildGraphQLHousehold\`) for a
  caller who has just stopped being a member — the same thing
  \`requireHouseholdMember\` would deny them at that point. A member
  leaving/a household being deleted is a known, accepted staleness gap
  (§14.2.10) — another device's view catches up on next route entry or
  foreground, not via a push.
  """
  onHouseholdChanged(householdId: ID!): Household
    @aws_subscribe(mutations: ["joinHousehold", "rotateInviteCode", "updateHouseholdSettings"])

  """
  Pushes the \`Menu\` to every other connected device in \`householdId\` when
  a new one is created (D9-carryover, E2E_MVP_PLAN.md §17.2.9). Attached to
  \`createMenu\` ONLY — deliberately NOT \`addMenuItem\`/\`removeMenuItem\`/
  \`autoFillWeek\`, all three of which return actively-consumed non-\`Menu\`
  shapes (\`MenuItem!\`/\`Boolean!\`/\`AutoFillResult!\`) that a D1-style
  widening to \`Menu!\` would break at real cost to their existing callers,
  out of this week's budget — the same "structural mismatch is a real
  reason to leave a mutation off the list" precedent \`onHouseholdChanged\`
  already sets for \`leaveHousehold\`/\`deleteHousehold\` above. Same
  subscribe-time Lambda-resolver authorization pattern as every other
  subscription in this schema (SD §10.4 deviation, §11.2.9): a non-member
  or nonexistent \`householdId\` is denied identically. A household member
  adding/auto-filling items on one device produces no push to a second
  device this week — an accepted staleness gap, covered by refetch-on-
  route-entry/foreground like every other unattached mutation (§17.5.5).
  """
  onMenuChanged(householdId: ID!): Menu
    @aws_subscribe(mutations: ["createMenu"])

  """
  Pushes \`true\` to every other connected device in \`householdId\` the
  moment \`deleteHousehold\` removes it (D7, E2E_MVP_PLAN.md §17.2.7) —
  fixes the subscribe-time-only re-authorization gap (§14, row 14 of
  §17.1's forward-reference table): a member whose access is revoked
  mid-session otherwise keeps their already-open \`onPantryChanged\`/
  \`onRecipeChanged\`/\`onHouseholdChanged\`/\`onMenuChanged\` sockets live
  until they background/foreground or their connection drops for an
  unrelated reason. AppSync provides no server-side API to force-close a
  specific established connection (confirmed while designing this slice —
  unlike API Gateway WebSocket's \`@connections\` endpoint), so this is a
  reactive signal, not a server-side eviction: on receipt, the client is
  expected to immediately unsubscribe every live subscription scoped to
  \`householdId\` and route away, rather than wait for its own next
  reconnect/foreground cycle to re-run subscribe-time authorization.

  Zero return-type widening — \`deleteHousehold\` already returns
  \`Boolean!\`, matching this field's \`Boolean\` exactly, the same
  literal-type-match constraint D1/D9-carryover both work within. Same
  subscribe-time Lambda-resolver authorization pattern as every other
  subscription in this schema (SD §10.4 deviation, §11.2.9), reusing
  \`requireHouseholdMember\` unchanged: a non-member or nonexistent
  \`householdId\` is denied identically. \`deleteHousehold\` is the only
  mutation in this codebase today that instantly removes *other*
  members' access mid-session (\`leaveHousehold\` is self-service — the
  leaver's own socket is not a security concern); a future "remove one
  member" mutation must extend this field's \`@aws_subscribe\` list when it
  ships (§17.5.4).
  """
  onMembershipRevoked(householdId: ID!): Boolean
    @aws_subscribe(mutations: ["deleteHousehold"])

  """
  Pushes the \`ShoppingList\` to every other connected device in
  \`householdId\` on any of the four mutations that change it (D1, cashing
  in W11 D1's own promise — E2E_MVP_PLAN.md §18.2.1, W12 S3):
  \`generateShoppingList\`/\`regenerateShoppingList\` (already \`ShoppingList!\`
  since W11 S2, no change needed) and \`haveIt\`/\`markPurchased\` (both
  widened to \`ShoppingList!\` specifically so they could attach here — SD
  §6.1's own comment on \`haveIt\` named this subscription as future work
  since W11). Per §11.2.12's already-locked "every push means refetch, no
  event-type discriminator" contract, the pushed payload's exact shape
  doesn't matter to any consumer — the affected item remains reachable via
  \`ShoppingList.items\` regardless of which of the four mutations fired.
  Same subscribe-time Lambda-resolver authorization pattern as every other
  subscription in this schema (SD §10.4 deviation, §11.2.9), reusing
  \`requireHouseholdMember\` unchanged: a non-member or nonexistent
  \`householdId\` is denied identically.
  """
  onShoppingListChanged(householdId: ID!): ShoppingList
    @aws_subscribe(
      mutations: ["generateShoppingList", "regenerateShoppingList", "haveIt", "markPurchased"]
    )
}

type User {
  id: ID!
  email: String!
  displayName: String
  avatarUrl: String
  households: [HouseholdMembership!]!
}

type Household {
  id: ID!
  name: String!
  inviteCode: String!
  primaryUserId: ID!
  members: [HouseholdMembership!]!
  settings: HouseholdSettings!
  subscriptionStatus: SubscriptionStatus!
}

type HouseholdMembership {
  id: ID!
  household: Household!
  user: User!
  role: HouseholdRole!
  joinedAt: AWSDateTime!
}

enum HouseholdRole {
  primary
  member
}

enum SubscriptionStatus {
  free
  trial
  active
  past_due
  cancelled
}

type HouseholdSettings {
  householdId: ID!
  mealsEnabled: [MealType!]!
  mealStructure: AWSJSON!
  cuisineTier1: [CuisineTier1!]!
  cuisineTier2Weights: AWSJSON!
  dietaryTags: [DietaryTag!]!
  allergens: [String!]!
  skipIngredients: [String!]!
}

enum MealType {
  breakfast
  lunch
  snacks
  dinner
}

enum CuisineTier1 {
  north_indian
  south_indian
  pan_india
  indo_chinese
  continental
}

enum DietaryTag {
  veg
  vegan
  jain
  eggetarian
  gluten_free
  dairy_free
}

"""
A partial patch for \`Mutation.updateHouseholdSettings\` — every field is
optional (absent = "leave unchanged"). Sending an explicit \`null\` for any
field is rejected server-side; clearing a field is not yet supported.
\`mealStructure\`/\`cuisineTier2Weights\` are \`AWSJSON\` — see \`HouseholdSettings\`
for their validated shapes.
"""
input HouseholdSettingsInput {
  mealsEnabled: [MealType!]
  mealStructure: AWSJSON
  cuisineTier1: [CuisineTier1!]
  cuisineTier2Weights: AWSJSON
  dietaryTags: [DietaryTag!]
  allergens: [String!]
  skipIngredients: [String!]
}

"""
The caller's own notification preferences for one household
(E2E_MVP_PLAN.md §14.2.6/§14.2.7). \`fcm_token\` is deliberately NOT a field
here — it is a device push credential, stored server-side (\`notification_
preferences.fcm_token\`, SD §7.1) for W20's use, but no client ever reads it
back through the API.
"""
type NotificationPreferences {
  householdId: ID!
  listChanges: Boolean!
  mealReminder: Boolean!
  expiry: Boolean!
  activity: Boolean!
}

"""
A partial patch for \`Mutation.updateNotificationPreferences\` — every field is
optional (absent = "leave unchanged"). Sending an explicit \`null\` for any
field is rejected server-side; clearing a field is not a supported operation.
"""
input NotificationPreferencesPatchInput {
  listChanges: Boolean
  mealReminder: Boolean
  expiry: Boolean
  activity: Boolean
}

"""
One pantry item belonging to a household. \`unit\`/\`category\` are free text,
server-side-canonicalised against a known set rather than closed enums
(E2E_MVP_PLAN.md §11.2.4) — a user typing an uncommon unit isn't rejected,
it just doesn't get normalised. \`expiryDate\` is \`AWSDate\` (date-only), not
\`AWSDateTime\` — the underlying column is a plain SQL \`DATE\`, and pairing it
with a timestamp scalar would attach a spurious time-of-day and timezone no
user chose (§11.2.5).
"""
type PantryItem {
  id: ID!
  householdId: ID!
  name: String!
  quantity: Float!
  unit: String!
  category: String
  isStaple: Boolean!
  expiryDate: AWSDate
  lowThreshold: Float
  addedBy: ID!
  addedAt: AWSDateTime!
  updatedAt: AWSDateTime!
}

"""
Input for \`Mutation.addPantryItem\`. Deliberately has no \`addedBy\` field —
that value is always the verified caller's own id, never client-supplied.
"""
input PantryItemInput {
  name: String!
  quantity: Float!
  unit: String!
  category: String
  isStaple: Boolean
  expiryDate: AWSDate
  lowThreshold: Float
}

"""
A partial patch for \`Mutation.updatePantryItem\` — every field is optional
(absent = "leave unchanged"). Sending an explicit \`null\` for any field is
rejected server-side; clearing a field is not yet supported. Same shape and
semantics as \`HouseholdSettingsInput\`, deliberately a separate type from
\`PantryItemInput\` rather than reusing it — \`PantryItemInput\`'s \`name\`/
\`quantity\`/\`unit\` are required, which is correct for a create but wrong for
a patch.
"""
input PantryItemPatchInput {
  name: String
  quantity: Float
  unit: String
  category: String
  isStaple: Boolean
  expiryDate: AWSDate
  lowThreshold: Float
}

enum RecipeSource {
  user
  url
  curated
  ai
  freeform_ai
}

"""
Provenance attribution for \`Mutation.createRecipe\`'s confirm-a-draft path
(W7 S6, §13.2.4 D2). \`sourceType\` is restricted server-side to \`url\`/
\`freeform_ai\` — \`curated\`/\`ai\` are values only the server itself ever
sets (the W13/W14 curated seeder, a future cook-from-pantry feature) and
a client-supplied \`curated\`/\`ai\` here is rejected, not silently accepted.
\`sourceUrl\` is required exactly when \`sourceType: url\`.
"""
input RecipeSourceAttribution {
  sourceType: RecipeSource!
  sourceUrl: String
}

"""
Meal-slot categorization a recipe fills — unrelated to \`HouseholdRole\`
(primary/member) despite the shared word "role" (E2E_MVP_PLAN.md §12.7 D1,
confirmed with the founder rather than assumed). Required on
\`RecipeInput\`/\`RecipePatchInput\` with no default — the "role assignment
required" DoD gate (§12.7 D1/D2). Drives which slot a recipe can fill in a
future weekly plan (W9/W10); \`drink\` exists but is post-MVP scope for
planning (PRD §7.1).
"""
enum RecipeRole {
  breakfast
  carb
  sabzi_dal
  accompaniment
  snack
  sweet
  drink
}

"""
A household recipe. \`role\`/\`cuisineTier1\`/\`dietaryTags\` are closed enums,
unlike \`PantryItem\`'s free-text \`unit\`/\`category\` — an unrecognised value
is rejected server-side at write time and never persisted
(E2E_MVP_PLAN.md §12.2.6). \`sourceType\` and \`createdAt\`/\`updatedAt\` are
never client-supplied.
"""
type Recipe {
  id: ID!
  householdId: ID!
  sourceType: RecipeSource!
  sourceUrl: String
  title: String!
  description: String
  servings: Int!
  prepMin: Int
  cookMin: Int
  cuisineTier1: CuisineTier1
  cuisineTier2: String
  dietaryTags: [DietaryTag!]!
  role: RecipeRole!
  inRotation: Boolean!
  isFavorite: Boolean!

  """
  Resolved by a separate field resolver, not hydrated inline on
  \`Query.recipes\` (E2E_MVP_PLAN.md §12.2.7) — a Library-style query that
  never selects this field never pays for the join, which matters at the
  280-300 recipe scale risk R7 (§6) is scoped around. RLS is the only
  authorization layer on this field (there is no \`householdId\` argument to
  gate on at the app layer) — see \`resolvers/recipeIngredients.ts\`'s doc.
  """
  ingredients: [RecipeIngredient!]!
  steps: [String!]!
  createdAt: AWSDateTime!
  updatedAt: AWSDateTime!
}

type RecipeIngredient {
  id: ID!
  name: String!
  quantity: Float
  unit: String
  category: String
  notes: String
  isStaple: Boolean!
}

"""
One household's meal plan for a single calendar week (W9, E2E_MVP_PLAN.md
§15). \`weekStartDate\` is \`AWSDateTime!\` on the wire but stored as a plain
\`DATE\` server-side — a week boundary is a calendar date, not a
timezone-attached instant (§15.2.4); the time-of-day component is always
midnight UTC and carries no meaning.
"""
type Menu {
  id: ID!
  householdId: ID!
  weekStartDate: AWSDateTime!
  items: [MenuItem!]!
}

"""
One recipe placed into one slot of a \`Menu\`. \`slotRole\` is captured at
placement time and does NOT track the recipe's own \`role\` if that's
changed later via \`updateRecipe\` — a menu is a snapshot of what was
planned, not a live view (§15.5.2).
"""
type MenuItem {
  id: ID!
  menuId: ID!
  recipe: Recipe!
  dayOfWeek: Int!
  mealSlot: MealType!
  slotRole: RecipeRole!
  servingsOverride: Int
  madeAt: AWSDateTime
}

"""
Input for \`Mutation.addMenuItem\` (W9 S3, E2E_MVP_PLAN.md §15.3) — every
field except \`servingsOverride\` mirrors \`MenuItem\`'s own shape (minus \`id\`/
\`menuId\`, which the mutation's own arguments/return value supply). There is
no update/patch mutation for a placed item — changing one is remove-then-add
(PRD §6's locked "+ add" pattern over drag-and-drop).
"""
input MenuItemInput {
  recipeId: ID!
  dayOfWeek: Int!
  mealSlot: MealType!
  slotRole: RecipeRole!
  servingsOverride: Int
}

"""
A household's generated shopping list for one week's \`Menu\` (W11 S1/S2,
E2E_MVP_PLAN.md §17). \`generatedFromMenuId\` is nullable purely to match the
underlying \`shopping_lists.generated_from_menu_id\` column's own nullable
FK — every list \`generateShoppingList\`/\`regenerateShoppingList\` produces
this week always has one, since neither mutation exists without a
\`menuId\`. \`closedAt\`/\`aiStaplesNote\` are populated by future weeks (list
closure, the W15 AI staples note) — always \`null\` for everything W11
writes.
"""
type ShoppingList {
  id: ID!
  householdId: ID!
  generatedFromMenuId: ID
  createdAt: AWSDateTime!
  closedAt: AWSDateTime
  aiStaplesNote: String
  items: [ShoppingListItem!]!
}

"""
One line on a \`ShoppingList\` — either auto-generated from a recipe's
ingredients (\`sourceRecipeId\` non-null, every item S2's
\`generateShoppingList\`/\`regenerateShoppingList\` produce) or manually added
(\`sourceRecipeId: null\`, reserved for a future \`addShoppingListItem\` — not
built this week). D8's origin marker (§17.2.8) doubles as this field: no
separate boolean. \`purchased\`/\`purchasedBy\`/\`purchasedAt\`/\`movedToPantry\`
are all set together, atomically, by \`haveIt\` (W11 S3) — always
\`false\`/\`null\` for everything S2 writes, and never \`false\` again once
\`haveIt\` has marked an item (see \`Mutation.haveIt\`'s own \`CONFLICT\` doc).
"""
type ShoppingListItem {
  id: ID!
  name: String!
  quantity: Float
  unit: String
  category: String
  sourceRecipeId: ID
  purchased: Boolean!
  purchasedBy: ID
  purchasedAt: AWSDateTime
  movedToPantry: Boolean!
}

"""
Input shape for the not-yet-built \`addShoppingListItem\` (W12+, not called
by any resolver this week) — defined now, alongside \`ShoppingList\`/
\`ShoppingListItem\`, so the full shopping-list SDL package lands together
(same "define the input type ahead of its mutation" precedent
\`RecipeInput\` set in W6, E2E_MVP_PLAN.md §12.7 D3) and D8's schema design
needs zero rework once it ships.
"""
input ShoppingListItemInput {
  name: String!
  quantity: Float
  unit: String
  category: String
}

"""
One slot \`autoFillPreview\`/\`autoFillWeek\` could not fill (W10 §16.2.3,
D5) — either the household has no in-rotation recipes for \`slotRole\` at
all, or (only reachable via \`autoFillWeek\`'s own live re-validation) the
slot stopped being available between when a proposal was generated and
when it was committed. Never distinguishes the two reasons at the type
level — see each resolver's own doc for what's actually knowable at that
point.
"""
type UnfilledSlot {
  dayOfWeek: Int!
  mealSlot: MealType!
  slotRole: RecipeRole!
}

"""
One recipe \`autoFillPreview\` proposes for one empty slot — NOT YET
WRITTEN to \`menu_items\` (§16.2.1's dry-run design). \`recipeId\`/
\`dayOfWeek\`/\`mealSlot\`/\`slotRole\` are exactly \`MenuItemInput\`'s own
shape, so a client can echo a (possibly user-edited) subset straight back
as \`Mutation.autoFillWeek\`'s \`items\` argument to commit it.
"""
type ProposedMenuItem {
  recipeId: ID!
  recipe: Recipe!
  dayOfWeek: Int!
  mealSlot: MealType!
  slotRole: RecipeRole!
}

type AutoFillPreviewResult {
  items: [ProposedMenuItem!]!
  filledCount: Int!
  unfilledSlots: [UnfilledSlot!]!
}

type AutoFillResult {
  menu: Menu!
  filledCount: Int!
  unfilledSlots: [UnfilledSlot!]!
}

"""
Input for \`Mutation.createRecipe\` (a later W6 slice — this type is defined
now so the full recipe SDL package lands together, E2E_MVP_PLAN.md §12.7
D3). No \`id\`, \`householdId\`, \`sourceType\`, or \`isFavorite\` — all
server-owned (\`sourceType\` is set to \`user\` for a caller-created recipe;
a create-time favorite isn't in any wireframe). \`role\` is REQUIRED with no
default. \`ingredients\` order is the array index — there is no
client-supplied \`sortOrder\`.
"""
input RecipeInput {
  title: String!
  description: String
  servings: Int
  prepMin: Int
  cookMin: Int
  cuisineTier1: CuisineTier1
  cuisineTier2: String
  dietaryTags: [DietaryTag!]
  role: RecipeRole!
  inRotation: Boolean
  ingredients: [RecipeIngredientInput!]!
  steps: [String!]!
}

input RecipeIngredientInput {
  name: String!
  quantity: Float
  unit: String
  category: String
  notes: String
  isStaple: Boolean
}

"""
An UNSAVED, UNPERSISTED proposal produced by \`Mutation.parseFreeformRecipe\`
(and, later, \`importRecipeFromUrl\`, W7 S5). Deliberately NOT a \`Recipe\`: it
has no \`id\`, no \`householdId\`, and no timestamps, so it cannot be mistaken
for a stored row by any client cache or mapper (E2E_MVP_PLAN.md §13.2.3,
D1 — an SD §6.1 deviation from the originally-planned \`Recipe!\` return
type). Nothing is written to the database until the user confirms and the
client calls \`Mutation.createRecipe\` with the corresponding \`source\`
attribution (§13.2.4).
"""
type RecipeDraft {
  title: String
  description: String
  servings: Int
  prepMin: Int
  cookMin: Int
  cuisineTier1: CuisineTier1
  cuisineTier2: String
  dietaryTags: [DietaryTag!]!

  """NULLABLE and unconfirmed — an AI-proposed role does not satisfy W6 D1's "role assignment required," the user must still affirmatively confirm or change it before \`createRecipe\` (§13.2.6 D5)."""
  role: RecipeRole
  ingredients: [RecipeIngredientDraft!]!
  steps: [String!]!

  """Set by \`importRecipeFromUrl\` (W7 S5); always null for \`parseFreeformRecipe\`."""
  sourceUrl: String

  """
  Human-readable, already-localisable-later notes about what the parser or
  the model could not determine or had to discard — e.g. an unrecognised
  cuisine value that was dropped rather than failing the whole parse
  (§13.2.5 D4). Never an error channel: a draft with warnings is still a
  draft.
  """
  warnings: [String!]!
}

type RecipeIngredientDraft {
  """The original, unmodified source string (e.g. \`"2 cups atta, sifted"\`). Kept verbatim so nothing the parser could not decompose is silently lost."""
  raw: String!
  name: String!
  quantity: Float
  unit: String
  notes: String
}

"""
A partial patch for \`Mutation.updateRecipe\` (a later W6 slice). Every
scalar field is optional (absent = "leave unchanged"); an explicit \`null\`
is rejected server-side, the same convention as \`PantryItemPatchInput\`/
\`HouseholdSettingsInput\`. \`ingredients\`/\`steps\` are a third semantic this
schema hasn't used before: optional, but when present they REPLACE the
whole list rather than patching individual entries — a list can't express
"change ingredient 3" any other way (E2E_MVP_PLAN.md §12.2.4). An explicit
empty list (\`ingredients: []\`) clears every ingredient; an absent
\`ingredients\` key leaves the existing list untouched.
"""
input RecipePatchInput {
  title: String
  description: String
  servings: Int
  prepMin: Int
  cookMin: Int
  cuisineTier1: CuisineTier1
  cuisineTier2: String
  dietaryTags: [DietaryTag!]
  role: RecipeRole
  inRotation: Boolean
  ingredients: [RecipeIngredientInput!]
  steps: [String!]
}
",
