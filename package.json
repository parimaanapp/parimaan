{
  "name": "parimaan",
  "version": "0.0.0",
  "private": true,
  "description": "Household-shared meal planning and pantry app for Indian kitchens — monorepo root",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0 <21.0.0",
    "pnpm": ">=9.0.0 <10.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm -r --if-present test",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "mobile:analyze": "cd mobile && flutter analyze",
    "mobile:test": "cd mobile && flutter test"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^20.19.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
