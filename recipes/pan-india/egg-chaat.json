{
  "title": "Egg Chaat",
  "description": "Boiled eggs quartered and tossed with onion, tomato, chaat masala and lemon, a quick high protein snack.",
  "servings": 2,
  "prepMin": 10,
  "cookMin": 10,
  "cuisineTier1": "pan_india",
  "cuisineTier2": "pan_regional",
  "dietaryTags": ["eggetarian", "gluten_free", "dairy_free"],
  "role": "snack",
  "ingredients": [
    { "name": "Egg", "quantity": 4, "unit": "piece", "category": "eggs" },
    { "name": "Onion", "quantity": 0.5, "unit": "piece", "category": "produce", "notes": "finely chopped" },
    { "name": "Tomato", "quantity": 0.5, "unit": "piece", "category": "produce", "notes": "finely chopped" },
    { "name": "Green Chilli", "quantity": 1, "unit": "piece", "category": "produce", "notes": "finely chopped" },
    { "name": "Chaat Masala", "quantity": 1, "unit": "tsp", "category": "spice" },
    { "name": "Red Chilli Powder", "quantity": 0.25, "unit": "tsp", "category": "spice", "isStaple": true },
    { "name": "Black Pepper Powder", "quantity": 0.25, "unit": "tsp", "category": "spice", "isStaple": true },
    { "name": "Lemon", "quantity": 0.5, "unit": "piece", "category": "produce", "notes": "juiced" },
    { "name": "Coriander Chutney", "quantity": 1, "unit": "tbsp", "category": "condiment" },
    { "name": "Coriander Leaves", "quantity": 1, "unit": "tbsp", "category": "produce", "notes": "chopped" },
    { "name": "Salt", "quantity": 0.25, "unit": "tsp", "category": "dry_goods", "isStaple": true }
  ],
  "steps": [
    "Boil the 4 eggs in water for 9 to 10 minutes, then cool in cold water and peel.",
    "Cut each egg into quarters and arrange in a bowl.",
    "Add the onion, tomato and green chilli over the eggs.",
    "Sprinkle the chaat masala, red chilli powder, black pepper powder and salt, then drizzle over the coriander chutney and lemon juice.",
    "Toss gently, top with coriander leaves and serve."
  ]
}
