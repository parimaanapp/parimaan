{
  "title": "Burani Raita",
  "description": "Gujarati garlic-spiked yogurt raita with a quick ghee and mustard tempering.",
  "servings": 4,
  "prepMin": 10,
  "cookMin": 5,
  "cuisineTier1": "north_indian",
  "cuisineTier2": "gujarati",
  "dietaryTags": [
    "veg",
    "gluten_free"
  ],
  "role": "accompaniment",
  "ingredients": [
    {
      "name": "Curd",
      "quantity": 2,
      "unit": "cup",
      "category": "dairy"
    },
    {
      "name": "Garlic",
      "quantity": 4,
      "unit": "piece",
      "category": "produce",
      "notes": "crushed"
    },
    {
      "name": "Green Chilli",
      "quantity": 1,
      "unit": "piece",
      "category": "produce",
      "notes": "finely chopped"
    },
    {
      "name": "Ghee",
      "quantity": 1,
      "unit": "tsp",
      "category": "oil"
    },
    {
      "name": "Cumin Seeds",
      "quantity": 0.5,
      "unit": "tsp",
      "category": "spice",
      "isStaple": true
    },
    {
      "name": "Red Chilli Powder",
      "quantity": 0.25,
      "unit": "tsp",
      "category": "spice",
      "isStaple": true
    },
    {
      "name": "Salt",
      "quantity": 0.5,
      "unit": "tsp",
      "category": "dry_goods",
      "isStaple": true
    },
    {
      "name": "Coriander Leaves",
      "quantity": 1,
      "unit": "tbsp",
      "category": "produce",
      "notes": "chopped"
    }
  ],
  "steps": [
    "Whisk the curd until smooth and stir in the salt and chopped green chilli.",
    "Heat the ghee in a small pan and add the cumin seeds.",
    "Add the crushed garlic and fry for 30 seconds until fragrant but not browned.",
    "Take the pan off the heat, add the red chilli powder and immediately pour the tempering over the curd.",
    "Mix and garnish with coriander leaves before serving."
  ]
}
