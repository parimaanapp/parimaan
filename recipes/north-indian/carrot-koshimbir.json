      "category": "dry_goods",
      "notes": "coarsely crushed; roasted"
    },
    {
      "name": "Green Chilli",
      "quantity": 1,
      "unit": "piece",
      "category": "produce",
      "notes": "finely chopped"
    },
    {
      "name": "Lemon",
      "quantity": 1,
      "unit": "piece",
      "category": "produce",
      "notes": "juice"
    },
    {
      "name": "Sugar",
      "quantity": 1,
      "unit": "tsp",
