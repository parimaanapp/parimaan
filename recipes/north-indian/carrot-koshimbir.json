{
  "title": "Carrot Koshimbir",
  "description": "Maharashtrian grated carrot salad with crushed peanuts, lemon and a mustard tempering.",
  "servings": 4,
  "prepMin": 10,
  "cookMin": 5,
  "cuisineTier1": "north_indian",
  "cuisineTier2": "maharashtrian",
  "dietaryTags": [
