  "steps": [
    "Grate the carrots and place them in a mixing bowl.",
    "Add the crushed peanuts, green chilli, sugar and salt.",
    "Heat the oil in a small pan and crackle the mustard seeds, then add the curry leaves.",
    "Pour the tempering over the carrots and mix.",
    "Add the lemon juice and coriander leaves, toss and serve immediately."
  ]
}
