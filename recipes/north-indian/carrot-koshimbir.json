    },
    {
      "name": "Curry Leaves",
      "quantity": 1,
      "unit": "g",
      "category": "produce",
      "notes": "about 6 leaves",
      "isStaple": true
    },
    {
      "name": "Coriander Leaves",
      "quantity": 1,
      "unit": "tbsp",
      "category": "produce",
      "notes": "chopped"
