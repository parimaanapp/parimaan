  ],
  "steps": [
    "Roast the papads over a flame or on a dry tawa until crisp, then break them into medium pieces.",
    "Whisk the curd with the besan, turmeric, chilli powder and coriander powder until smooth.",
    "Heat the oil in a pan, add cumin seeds and hing, then the onion and green chilli and cook until soft.",
    "Lower the heat, pour in the curd mixture with the water and stir constantly until it comes to a gentle simmer.",
    "Cook for 5 minutes, stirring, so the gravy thickens slightly without splitting.",
    "Add the papad pieces just before serving so they stay slightly firm, and garnish with coriander."
  ]
}
