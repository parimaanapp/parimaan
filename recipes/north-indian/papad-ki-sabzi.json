{
  "title": "Papad Ki Sabzi",
  "description": "Rajasthani pantry-staple sabzi where roasted papad pieces are simmered in a spiced curd gravy.",
  "servings": 4,
  "prepMin": 10,
  "cookMin": 20,
  "cuisineTier1": "north_indian",
  "cuisineTier2": "rajasthani",
