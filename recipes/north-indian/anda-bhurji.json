  "steps": [
    "Beat the eggs with half the salt until frothy.",
    "Heat the oil and crackle the cumin seeds.",
    "Add the onion, green chillies and ginger and cook until the onion turns translucent.",
    "Add the tomatoes, turmeric, chilli powder and remaining salt and cook until soft.",
    "Lower the heat, pour in the eggs and stir gently with a spatula until just set but still moist.",
    "Finish with the coriander leaves and serve at once."
  ]
