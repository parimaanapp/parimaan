      "name": "Salt",
      "quantity": 1,
      "unit": "tsp",
      "category": "dry_goods",
      "isStaple": true
    }
  ],
  "steps": [
    "Crack the eggs into a bowl, add a pinch of salt and whisk lightly.",
    "Heat the oil in a wide pan and add the cumin seeds until they sizzle.",
    "Add the onion and green chilli and cook until the onion is soft and light golden.",
    "Stir in the ginger paste, then the tomato, and cook until it turns soft and pulpy.",
    "Add turmeric, chilli powder, coriander powder and the remaining salt and cook for 1 minute.",
    "Lower the heat, pour in the eggs and fold continuously for 2-3 minutes until just set but still moist.",
    "Sprinkle garam masala and coriander leaves, and serve hot."
  ]
}
