      "quantity": 1,
      "unit": "tsp",
      "category": "spice",
      "isStaple": true
    },
    {
      "name": "Onion",
      "quantity": 2,
      "unit": "piece",
      "category": "produce",
      "notes": "finely chopped"
    },
    {
      "name": "Green Chilli",
      "quantity": 2,
      "unit": "piece",
      "category": "produce",
      "notes": "chopped"
    },
    {
      "name": "Ginger Paste",
      "quantity": 1,
      "unit": "tsp",
      "category": "condiment"
    },
    {
      "name": "Tomato",
      "quantity": 2,
      "unit": "piece",
