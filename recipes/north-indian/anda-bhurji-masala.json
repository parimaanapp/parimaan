{
  "title": "Anda Bhurji Masala",
  "description": "Dhaba-style scrambled eggs cooked with onion, tomato and spices, loose and juicy enough to scoop with roti.",
  "servings": 4,
  "prepMin": 10,
  "cookMin": 15,
  "cuisineTier1": "north_indian",
  "cuisineTier2": "punjabi",
  "dietaryTags": [
    "eggetarian",
    "gluten_free",
    "dairy_free"
  ],
  "role": "sabzi_dal",
