{
  "title": "Aloo Chaat",
  "description": "Pan-crisped boiled potato cubes tossed with chaat masala, roasted cumin, lemon and tamarind chutney, a Delhi street-food classic.",
  "servings": 3,
  "prepMin": 10,
  "cookMin": 15,
  "cuisineTier1": "north_indian",
  "cuisineTier2": "punjabi",
  "dietaryTags": ["veg", "vegan", "gluten_free", "dairy_free"],
  "role": "snack",
  "ingredients": [
    { "name": "Potato", "quantity": 3, "unit": "piece", "category": "produce", "notes": "boiled and cubed" },
    { "name": "Vegetable Oil", "quantity": 1, "unit": "tbsp", "category": "oil" },
    { "name": "Chaat Masala", "quantity": 1, "unit": "tsp", "category": "spice" },
    { "name": "Red Chilli Powder", "quantity": 0.5, "unit": "tsp", "category": "spice", "isStaple": true },
    { "name": "Cumin Powder", "quantity": 0.5, "unit": "tsp", "category": "spice", "notes": "roasted" },
    { "name": "Salt", "quantity": 0.5, "unit": "tsp", "category": "dry_goods", "isStaple": true },
    { "name": "Onion", "quantity": 0.5, "unit": "piece", "category": "produce", "notes": "finely chopped" },
    { "name": "Green Chilli", "quantity": 1, "unit": "piece", "category": "produce", "notes": "finely chopped" },
    { "name": "Jaggery Tamarind Chutney", "quantity": 1, "unit": "tbsp", "category": "condiment" },
    { "name": "Lemon", "quantity": 1, "unit": "piece", "category": "produce", "notes": "juiced" },
    { "name": "Coriander Leaves", "quantity": 2, "unit": "tbsp", "category": "produce", "notes": "chopped" }
  ],
  "steps": [
    "Heat the oil in a wide pan on medium-high heat and add the cubed potato in a single layer.",
    "Cook for 8 to 10 minutes, turning occasionally, until the edges are golden and crisp.",
    "Move the potato to a bowl and sprinkle on the chaat masala, red chilli powder, roasted cumin powder and salt.",
    "Add the onion, green chilli, tamarind chutney, lemon juice and coriander leaves.",
    "Toss well and serve hot, with toothpicks."
  ]
}
