{
  "title": "Masala Chaas",
  "description": "Cooling spiced buttermilk with roasted cumin, black salt, mint and green chilli, a light accompaniment to a heavy meal.",
  "servings": 3,
  "prepMin": 5,
  "cookMin": 0,
  "cuisineTier1": "north_indian",
