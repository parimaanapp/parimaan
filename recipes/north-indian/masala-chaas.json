    { "name": "Water", "quantity": 400, "unit": "ml", "category": "beverages", "notes": "cold" },
    { "name": "Cumin Powder", "quantity": 1, "unit": "tsp", "category": "spice", "notes": "roasted" },
    { "name": "Black Salt", "quantity": 0.5, "unit": "tsp", "category": "spice" },
    { "name": "Salt", "quantity": 0.25, "unit": "tsp", "category": "dry_goods", "isStaple": true },
