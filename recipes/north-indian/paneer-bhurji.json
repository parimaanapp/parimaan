      "quantity": 2,
      "unit": "tbsp",
      "category": "produce",
      "notes": "chopped"
    }
  ],
  "steps": [
    "Heat the oil in a pan and add the cumin seeds.",
    "Add the onion and green chilli and cook until the onion is translucent.",
    "Add the ginger paste and tomato and cook for 3 minutes until soft.",
    "Stir in turmeric, chilli powder and salt and cook for 30 seconds.",
    "Add the crumbled paneer and mix gently, cooking for 3-4 minutes without breaking it down further.",
    "Sprinkle garam masala and kasuri methi, and garnish with coriander leaves."
  ]
}
