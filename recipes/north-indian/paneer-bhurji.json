{
  "title": "Paneer Bhurji",
  "description": "Crumbled paneer scrambled with onion, tomato and spices, a quick dinner with roti or stuffed in sandwiches.",
  "servings": 4,
  "prepMin": 10,
  "cookMin": 15,
  "cuisineTier1": "north_indian",
  "cuisineTier2": "punjabi",
