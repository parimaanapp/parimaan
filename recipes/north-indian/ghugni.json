{
  "title": "Ghugni",
  "description": "Eastern Indian dried yellow pea curry simmered with onion, tomato and mustard oil, eaten with bread, puffed rice or luchi.",
  "servings": 4,
  "prepMin": 15,
  "cookMin": 40,
  "cuisineTier1": "north_indian",
  "cuisineTier2": "bengali",
  "dietaryTags": ["veg", "vegan", "gluten_free", "dairy_free"],
  "role": "breakfast",
  "ingredients": [
    { "name": "White Peas", "quantity": 200, "unit": "g", "category": "dal", "notes": "soaked overnight" },
    { "name": "Onion", "quantity": 1, "unit": "piece", "category": "produce", "notes": "finely chopped" },
    { "name": "Tomato", "quantity": 1, "unit": "piece", "category": "produce", "notes": "finely chopped" },
    { "name": "Ginger", "quantity": 10, "unit": "g", "category": "produce", "notes": "grated" },
    { "name": "Green Chilli", "quantity": 2, "unit": "piece", "category": "produce", "notes": "slit" },
    { "name": "Mustard Oil", "quantity": 2, "unit": "tbsp", "category": "oil" },
    { "name": "Cumin Seeds", "quantity": 1, "unit": "tsp", "category": "spice", "isStaple": true },
    { "name": "Bay Leaf", "quantity": 1, "unit": "piece", "category": "spice" },
    { "name": "Turmeric Powder", "quantity": 0.5, "unit": "tsp", "category": "spice", "isStaple": true },
    { "name": "Red Chilli Powder", "quantity": 0.5, "unit": "tsp", "category": "spice", "isStaple": true },
    { "name": "Garam Masala", "quantity": 0.5, "unit": "tsp", "category": "spice", "isStaple": true },
    { "name": "Salt", "quantity": 1, "unit": "tsp", "category": "dry_goods", "isStaple": true },
    { "name": "Coriander Leaves", "quantity": 2, "unit": "tbsp", "category": "produce", "notes": "chopped" },
    { "name": "Water", "quantity": 500, "unit": "ml", "category": "beverages" }
  ],
  "steps": [
    "Drain the soaked peas and pressure cook them with the salt and 500 ml of water for 4 whistles until soft but not mushy.",
    "Heat the mustard oil until it smokes lightly, then lower the heat and add the cumin seeds and bay leaf.",
    "Add the onion and sauté until golden, then stir in the ginger and green chilli.",
    "Add the tomato, turmeric powder and red chilli powder and cook until the oil separates.",
    "Add the cooked peas with their liquid and simmer for 10 minutes, mashing a few peas to thicken the gravy.",
    "Finish with garam masala and coriander leaves and serve hot."
  ]
}
