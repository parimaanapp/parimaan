{
  "title": "Vegetable Fried Rice",
  "description": "Takeaway-style Indo-Chinese fried rice with crisp vegetables, tossed on high heat with soy sauce and pepper.",
  "servings": 4,
  "prepMin": 15,
  "cookMin": 10,
  "cuisineTier1": "indo_chinese",
