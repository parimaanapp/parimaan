{
  "title": "Andhra Tomato Pappu",
  "description": "Tangy toor dal cooked down with ripe tomatoes and green chilli, finished with a garlic and mustard tempering.",
  "servings": 4,
  "prepMin": 10,
  "cookMin": 30,
  "cuisineTier1": "south_indian",
