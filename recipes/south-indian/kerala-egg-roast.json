{
  "title": "Kerala Egg Roast",
  "description": "Hard-boiled eggs simmered in a thick, caramelised onion-tomato masala with fennel, pepper and curry leaves.",
  "servings": 4,
  "prepMin": 15,
  "cookMin": 25,
  "cuisineTier1": "south_indian",
