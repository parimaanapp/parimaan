{
  "title": "Urulai Kizhangu Roast",
  "description": "Tamil-style crisp potato roast tossed with curry leaves, chilli and a hint of fennel.",
  "servings": 4,
  "prepMin": 10,
  "cookMin": 25,
  "cuisineTier1": "south_indian",
  "cuisineTier2": "tamil",
  "dietaryTags": [
    "veg",
    "vegan",
    "gluten_free"
  ],
  "role": "sabzi_dal",
  "ingredients": [
    {
      "name": "Potato",
      "quantity": 4,
      "unit": "piece",
      "category": "produce",
      "notes": "boiled, peeled and cubed"
    },
    {
      "name": "Vegetable Oil",
      "quantity": 3,
      "unit": "tbsp",
      "category": "oil"
    },
    {
      "name": "Mustard Seeds",
      "quantity": 1,
      "unit": "tsp",
      "category": "spice",
      "isStaple": true
    },
    {
      "name": "Fennel Seeds",
      "quantity": 1,
      "unit": "tsp",
      "category": "spice"
    },
    {
      "name": "Curry Leaves",
      "quantity": 1,
      "unit": "g",
      "category": "produce",
      "notes": "about 10 leaves",
      "isStaple": true
    },
    {
      "name": "Onion",
      "quantity": 1,
      "unit": "piece",
      "category": "produce",
      "notes": "finely sliced"
    },
    {
      "name": "Green Chilli",
      "quantity": 2,
      "unit": "piece",
      "category": "produce",
      "notes": "slit"
    },
    {
      "name": "Turmeric Powder",
      "quantity": 0.5,
      "unit": "tsp",
      "category": "spice",
      "isStaple": true
    },
    {
      "name": "Red Chilli Powder",
      "quantity": 1,
      "unit": "tsp",
      "category": "spice",
      "isStaple": true
    },
    {
      "name": "Coriander Powder",
      "quantity": 1,
      "unit": "tsp",
      "category": "spice",
      "isStaple": true
    },
    {
      "name": "Salt",
      "quantity": 1,
      "unit": "tsp",
      "category": "dry_goods",
      "isStaple": true
    },
    {
      "name": "Lemon",
      "quantity": 1,
      "unit": "piece",
      "category": "produce",
      "notes": "juice"
    }
  ],
  "steps": [
    "Boil the potatoes until just tender, cool, peel and cut into cubes.",
    "Heat the oil in a wide non-stick pan and crackle the mustard seeds and fennel seeds.",
    "Add the curry leaves, onion and green chilli and cook until the onion is lightly golden.",
    "Add the turmeric, chilli powder, coriander powder and salt and stir for 30 seconds.",
    "Add the potato cubes and toss gently so every piece is coated.",
    "Cook on medium heat for 10-12 minutes without crowding, turning occasionally, until crisp and browned at the edges.",
    "Finish with lemon juice and serve with sambar rice or rasam rice."
  ]
}
