  ],
  "steps": [
    "Boil the ash gourd with turmeric, salt and half a cup of water until tender.",
    "Grind the coconut, green chilli, cumin seeds, coriander seeds and soaked chana dal into a fine paste with a little water.",
    "Add the paste to the vegetables and simmer on low for 5 minutes.",
    "Turn the heat to the minimum and stir in the buttermilk; warm through without boiling.",
    "Heat the coconut oil, crackle the mustard seeds, then add dried red chilli and curry leaves.",
    "Pour the tempering over the huli and serve with rice."
  ]
}
