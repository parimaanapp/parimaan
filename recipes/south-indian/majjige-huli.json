{
  "title": "Majjige Huli",
  "description": "Karnataka buttermilk-coconut curry with ash gourd, mild and cooling.",
  "servings": 4,
  "prepMin": 15,
  "cookMin": 25,
  "cuisineTier1": "south_indian",
  "cuisineTier2": "karnataka",
