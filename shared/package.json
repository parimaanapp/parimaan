{
  "name": "@parimaan/shared",
  "version": "0.0.0",
  "private": true,
  "description": "GraphQL SDL (source of truth), generated TypeScript types, and Zod schemas",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema.graphql": "./schema.graphql"
  },
  "files": [
    "src",
    "generated",
    "schema.graphql"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . -c ../eslint.config.mjs --max-warnings=0",
    "test": "vitest run --passWithNoTests"
  }
}
