# Required by AWS Amplify Hosting for pnpm-workspace monorepo deploys
# (Turborepo and pnpm apps "require additional configuration" beyond
# npm/Yarn/Nx workspaces, per AWS's own docs:
# https://docs.aws.amazon.com/amplify/latest/userguide/monorepo-configuration.html#turborepo-pnpm-monorepo-configuration).
# Found live, W18's frontend-stack.ts build-spec work: without this,
# Amplify's build container cannot correctly resolve node_modules for a
# pnpm workspace during its own SSR compute post-processing step.
node-linker=hoisted
